rules_version = '2';

// Kraken's database rules. Phase 1: profiles. Everything not matched below,
// including `authCodes` (sign-in codes, server only), is closed to apps.
// The server uses admin credentials, which these rules don't apply to.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // What a profile may hold, and in what shape.
    function validProfile(data) {
      return data.keys().hasOnly([
               'uid', 'displayName', 'adultConfirmedAt', 'privacyAcceptedAt',
               'privacyPolicyVersion', 'upiId', 'pendingInviteCode'
             ])
          && data.uid == request.auth.uid
          && (!('displayName' in data) || data.displayName == null
              || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 40))
          && (!('upiId' in data) || data.upiId == null
              || (data.upiId is string && data.upiId.matches('^[A-Za-z0-9._-]{2,256}@[A-Za-z][A-Za-z0-9]{1,63}$')));
    }

    // users/{uid}: a person's own profile. Only they can read or change it.
    match /users/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && validProfile(request.resource.data);
    }
  }
}
